# Copie para /srv/prato/.env na VPS (modo 600). NUNCA versione o arquivo real.
DOMAIN=api.example.com
POSTGRES_DB=pratoemdia
POSTGRES_USER=pratoemdia
POSTGRES_PASSWORD=troque-por-um-segredo-longo
JWT_SECRET=troque-por-um-segredo-com-32-bytes-ou-mais
RESEND_API_KEY=re_troque
MAIL_FROM=noreply@example.com
APP_URL=https://example.com

# Backup (LUC-68): chave PÚBLICA do age; a privada fica fora da VPS e do provedor.
AGE_RECIPIENT=age1troque
BACKUP_DEST=r2:prato-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=troque
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=troque
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/troque
HEARTBEAT_URL=https://heartbeat.example.com/troque

# Observabilidade (LUC-69): Grafana Cloud (Alloy)
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=000000
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=000000
GRAFANA_CLOUD_API_KEY=troque
